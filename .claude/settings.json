{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/main-push-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking push target"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git remote -v)",
      "Bash(git switch -c:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(helm dependency update:*)",
      "Bash(helm dependency build:*)",
      "Bash(helm version:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(argocd app get:*)",
      "Bash(argocd app list:*)",
      "Bash(argocd app diff:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl patch:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(argocd app sync:*)",
      "Bash(argocd app set:*)",
      "Bash(argocd app delete:*)"
    ]
  }
}
